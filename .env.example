# cp .env.example .env. Never commit .env; backend and worker only read API keys.
DATABASE_URL=postgresql+psycopg://app:change_me@db:5432/papers
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=papers
REDIS_URL=redis://redis:6379/0
APP_TIMEZONE=Asia/Seoul
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
APP_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=24
SERPAPI_API_KEY=your_serpapi_api_key
# Contact email for Crossref polite pool / identifiable User-Agent
CROSSREF_MAILTO=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
IF_PROVIDER=imported
MAX_SEARCH_PAGES_PER_SOURCE=5
MAX_SERPAPI_REQUESTS_PER_JOB=8
MAX_HTTP_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=30
MAX_JOB_SECONDS=900
LLM_MAX_CALLS_PER_JOB=100
LLM_MAX_OUTPUT_TOKENS=1000
DEMO_MODE=false
RUN_LIVE_API_TESTS=false
# Explicitly permitted publisher HTML hosts, comma-separated. Empty disables HTML retrieval.
PUBLISHER_ALLOWED_HOSTS=
# Internal API address; contains no credentials, never NEXT_PUBLIC.
API_INTERNAL_URL=http://api:8000
